{
  "name": "fonteditor",
  "version": "0.1.0",
  "private": true,
  "description": "Monochrome bitmap font editor for variable- and fixed-width fonts",
  "author": "Simon Cooke",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^18.18.0 || >=20.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
